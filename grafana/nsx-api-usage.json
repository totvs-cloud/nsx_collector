      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "blue",
            "mode": "fixed"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "efcqeppjazvgga"
          },
          "query": "from(bucket: \"nsx\")\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"nsx_api_client_calls\")\n  |> filter(fn: (r) => r._field == \"count\")\n  |> filter(fn: (r) => r.site =~ /^${site:regex}$/)\n  |> group()\n  |> aggregateWindow(every: 1m, fn: sum, createEmpty: false)\n  |> last()",
          "refId": "A"
        }
      ]
    },
